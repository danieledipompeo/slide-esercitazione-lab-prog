% Logo: usa common/<file>.pdf o .png se esiste, altrimenti un segnaposto.
\newcommand{\loghetto}[2]{%
  \IfFileExists{#1.pdf}{\includegraphics[height=1.4cm]{#1.pdf}}{%
  \IfFileExists{#1.png}{\includegraphics[height=1.4cm]{#1.png}}{%
  \fbox{\parbox[c][1.4cm][c]{3.8cm}{\centering\small #2}}}}}

\newcommand{\titolo}[1]{%
  \begin{frame}[plain]
    \loghetto{logo_univaq}{Logo Universit\`a}\hfill\loghetto{logo_disim}{Logo Dipartimento}
    \vfill
    \begin{center}
      {\color{accento}\fontsize{26}{30}\selectfont\bfseries #1\par}
      \vspace{1.2em}
      {\large Laboratorio di Programmazione \textendash{} Esercitazione\par}
    \end{center}
    \vfill
  \end{frame}%
  \contatti}

